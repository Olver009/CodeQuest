      "starter": "<div class=\"row\">\n  <div class=\"item\">A</div>\n  <div class=\"item\">B</div>\n  <div class=\"item\">C</div>\n</div>\n<style>\n  /* TODO */\n</style>\n",
      "expected": "A B C",
      "must_contain": ["display:", "flex", "gap:", "justify-content:", "center", ".item"]
    }
  },
